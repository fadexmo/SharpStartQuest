@page "/Erreur"
@model ErrorModel
@{
    ViewData["Title"] = "Erreur";
}

<section class="panel narrow-panel">
    <span class="eyebrow">Erreur</span>
    <h1>La quête a dérapé.</h1>
    <p>Une erreur est survenue pendant le traitement de la requête.</p>

    @if (Model.ShowRequestId)
    {
        <p>
            <strong>Request ID:</strong> <code>@Model.RequestId</code>
        </p>
    }

    <a class="btn btn-primary" asp-page="/Index">Retour au dashboard</a>
</section>
